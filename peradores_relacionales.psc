Algoritmo peradores_relacionales
	definir n1, n2 Como Real
	escribir " ingrese numero 1 "
	leer n1
	escribir " ingrese numero 2 "
	leer n2
	escribir "¿n1 > n2? ", n1 > n2
	escribir " ¿n1 < n2 ?" , n1 < n2
	escribir " ¿n1 = n2 ?" , n1 = n2
	escribir " ¿n1 <> n2 ?", n1 <>n2
	escribir " ¿n1 >= n2 ?" , n1 >= n2
	escribir " ¿n1 <= n2 ?", n1 <= n2 
	
	
	
	
	
FinAlgoritmo

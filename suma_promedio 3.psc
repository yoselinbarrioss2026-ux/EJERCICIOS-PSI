Algoritmo suma_promedio
	
	Definir v1, v2, v3, v4, suma, promedio Como Real
	Escribir "ingrese valor 1: "
	leer v1
	Escribir "ingrese el valor 2: "
	leer v2
	Escribir "ingrese el valor 3 : " 
	leer v3
	Escribir "ingrese el valor 4: " 
	leer v4
	suma = v1+v2+v3+v4 
	promedio = suma/4
	Escribir "la suma es : ", suma
	Escribir "el promedio es : ", promedio 
	
	
	
	
	
FinAlgoritmo

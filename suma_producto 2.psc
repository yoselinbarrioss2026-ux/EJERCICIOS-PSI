Algoritmo suma_producto
	Definir n1,n2,n3,n4, suma,producto como real 
	Escribir "ingrese numero 1: "
	leer n1
	Escribir "ingrese numero 2: "
	leer n2
	Escribir "ingrese numero 3: "
	leer n3
	Escribir "ingrese el numero 4: "
	leer n4 
	suma = n1 + n2 
	producto = n3 * n4 
	
	Escribir " la suma de los dos perimetros es : " , suma 
	Escribir " el producto del tercero y cuarto es : " , producto
	
	
	
FinAlgoritmo
